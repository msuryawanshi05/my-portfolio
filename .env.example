# =============================================================================
# PORTFOLIO BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# CLERK AUTH
# Get these from: https://dashboard.clerk.com → your app → API Keys
# ---------------------------------------------------------------------------

# Safe to expose in frontend HTML/JS (publishable = public key):
CLERK_PUBLISHABLE_KEY=pk_live_...

# NEVER put in frontend code. Backend only.
CLERK_SECRET_KEY=sk_live_...

# Clerk's JWKS endpoint — use your instance URL from the Clerk dashboard.
# Format: https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
# Or the default: https://api.clerk.com/v1/jwks (works for most apps)
CLERK_JWKS_URL=https://<your-clerk-instance>/.well-known/jwks.json

# Your personal Clerk user ID — the ONLY account that can access /admin.
# How to get it:
#   1. Deploy the app (or run locally with uvicorn)
#   2. Sign in via /admin using your Clerk account
#   3. Go to Clerk dashboard → Users → click your user → copy the User ID
#   4. Paste it here (format: user_2abc...)
ADMIN_CLERK_USER_ID=user_...

# ---------------------------------------------------------------------------
# DATABASE — Azure Database for PostgreSQL Flexible Server
# ---------------------------------------------------------------------------
# Azure portal → your PostgreSQL server → Connection strings → Python
# Format (no sslmode needed for Flexible Server with managed identity,
# but add ?sslmode=require for username/password auth):
DATABASE_URL=postgresql://adminuser:yourpassword@yourserver.postgres.database.azure.com:5432/portfolio?sslmode=require

# For local development (Docker PostgreSQL or local install):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# ---------------------------------------------------------------------------
# APP SETTINGS (optional — FastAPI uses these)
# ---------------------------------------------------------------------------
ENVIRONMENT=development
